# Copie para .env e preencha. O .env está no .gitignore — nunca commitar.

# Chave da API Anthropic (Camada B de classificação — opcional; sem ela os
# itens ambíguos ficam como "incerto" = 🟡)
ANTHROPIC_API_KEY=

# Mercado Livre.
# A busca pública (/sites/MLB/search) vem sendo bloqueada pelo ML desde
# 2024/2025 para a maioria das aplicações. O caminho garantido é o token do
# PRÓPRIO vendedor (crie uma aplicação em developers.mercadolivre.com.br,
# autorize com a conta da loja e cole o access token) + `--seller me`.
ML_ACCESS_TOKEN=
# Alternativa (token de aplicação, sem usuário — pode não ter acesso à busca):
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Base de produtos homologados da ANATEL ("Produtos de Telecomunicações
# Homologados pela Anatel", dados.gov.br). Aceita URL http(s) OU caminho local
# de um .csv/.zip baixado manualmente. Vazio = URLs padrão embutidas.
ANATEL_CSV_URL=
