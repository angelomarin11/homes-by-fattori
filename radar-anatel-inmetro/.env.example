# Copie para .env e preencha. O .env está no .gitignore — nunca commitar.

# Chave da API Anthropic (Camada B de classificação — opcional; sem ela os
# itens ambíguos ficam como "incerto" = 🟡)
ANTHROPIC_API_KEY=

# Mercado Livre — só necessário se a API pública bloquear as chamadas sem auth.
# Opção 1: token pronto (gerado em developers.mercadolivre.com.br)
ML_ACCESS_TOKEN=
# Opção 2: credenciais da aplicação (fluxo client_credentials)
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# URL do CSV de produtos homologados da ANATEL (dados abertos).
# Deixe vazio para usar as URLs padrão embutidas.
ANATEL_CSV_URL=
